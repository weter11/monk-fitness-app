<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MonkFitnessApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonkFitness">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MonkFitness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".util.NotificationReceiver" />

        <!--
            Localization (§3): the app's application locale has to survive a restart on API 24–32 as well,
            and on those versions AndroidX owns that storage. This service is the opt-in for it — declared
            `android:enabled="false"` because it is a marker, never started, and it is what makes the
            app-language state the same one Android 13's own per-app language screen edits.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            The Share Sheet's transport (§30 step 13, §11): the provider that mints the `content://` URI a
            shared program file is handed over through. It is `exported="false"` — no other app may ask this
            app's provider for anything on its own — and `grantUriPermissions="true"`, which is what lets a
            single share carry a single file's read permission to the app the user picked.

            The authority is derived from the application id so it cannot drift from the authority
            `ProgramShareSheet.authority` computes at runtime.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/program_file_paths" />
        </provider>
    </application>

</manifest>
